{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "module": "ESNext",
    "jsx": "react-jsx",
    "moduleResolution": "Bundler",
    "strict": true,
    "baseUrl": .,
    "paths": {
      "@/components/*": ["src/lib/components/*"],
      "@/state/*": ["src/state/*"],
      "@/api/*": ["src/api/*"]
    },
    "types": ["vitest/globals", "@testing-library/jest-dom"]
  },
  "include": ["src", "server", "vitest.setup.ts"],
  "exclude": ["node_modules"]
}
